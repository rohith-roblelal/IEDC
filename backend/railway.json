{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/backend/**"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "alembic upgrade head"
    ],
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT"
  }
}